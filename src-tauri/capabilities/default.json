{
  "$schema": "https://schema.tauri.app/acl/capability",
  "identifier": "default",
  "description": "主窗口默认能力：核心事件与 IPC + 自定义标题栏窗控（T6.0）",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging"
  ]
}
